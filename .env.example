PROJECT_NAME="ArmiMarket Italia"
VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG=False
API_V1_STR="/api/v1"

# CAMBIA QUESTA CHIAVE — usa una stringa casuale lunga almeno 32 caratteri
SECRET_KEY="CHANGE_ME_generate_a_random_secret_key_here"

ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite (default per demo/free hosting)
DATABASE_URL="sqlite+aiosqlite:///./armimarket_prod.db"

UPLOAD_DIR="./app/static/uploads"
MAX_UPLOAD_SIZE_MB=5

# Credenziali Admin — cambia la password in produzione!
FIRST_SUPERUSER_EMAIL="admin@armimarket.it"
FIRST_SUPERUSER_PASSWORD="CHANGE_ME_admin_password"

# URL pubblico del sito (aggiorna con l'URL di Render dopo il deploy)
BASE_URL="https://armimarket-italia.onrender.com"

# Email SMTP (opzionale — lascia vuoto se non vuoi email reali)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_TLS=True
EMAILS_FROM_EMAIL="no-reply@armimarket.it"
EMAILS_FROM_NAME="ArmiMarket Italia"
